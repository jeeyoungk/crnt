{
  "name": "crnt",
  "description": "TypeScript library for async concurrency primitives",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --browser",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --check . --cache",
    "format:fix": "prettier --write . --cache",
    "check:attw": "attw --pack .",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm build && pnpm check:attw",
    "docs": "typedoc",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "async",
    "concurrency",
    "primitives",
    "typescript"
  ],
  "author": "jeeyoungk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeeyoungk/crnt.git"
  },
  "homepage": "https://crnt.jeeyoungk.com",
  "bugs": {
    "url": "https://github.com/jeeyoungk/crnt/issues"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@sinonjs/fake-timers": "^15.4.0",
    "@types/bun": "^1.4.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/browser-playwright": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-json-schema-validator": "^6.3.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "provenance": true
  },
  "packageManager": "pnpm@12.11.2",
  "version": "0.0.33"
}
